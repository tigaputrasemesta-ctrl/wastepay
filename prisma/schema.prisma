generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  nama         String
  role         String   @default("admin") // superadmin | admin | kasir | petugas
  noTelepon    String?
  foto         String?
  aktif        Boolean  @default(true)
  // Token version: increment saat ganti/reset password → semua sesi JWT lama
  // (yang membawa v lama) otomatis ditolak (revoke).
  tokenVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pembayaranVerifikasi Pembayaran[]   @relation("VerifiedBy")
  komplainResolved     Komplain[]     @relation("ResolvedBy")
  pengumuman           Pengumuman[]
  pengeluaran          Pengeluaran[]
  auditLogs            AuditLog[]     @relation("AuditUser")
  notifikasiDibuat     Notifikasi[]   @relation("NotifCreatedBy")
  rekonsiliasi         Rekonsiliasi[]
  petugasProfiles      Petugas[]
  klaimDiperiksa       KlaimPetugas[] @relation("KlaimDiperiksa")
  chat                 ChatPesan[]    @relation("ChatUser")
  artikel              Artikel[]
  sellerProfile        SellerProfile?
  carts                Cart[]
  orders               Order[]
  tenantId             String?
  tenant               Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model Kelurahan {
  id        Int      @id @default(autoincrement())
  nama      String   @unique // nama kelurahan (normalisasi, case-insensitive saat lookup)
  kode      String?  @unique // kode singkat utk kode pelanggan, misal "KAL" (Kalibaru)
  kecamatan String?
  kota      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wilayah        Wilayah[] @relation("WilayahKelurahan")
  petugas        Petugas[] @relation("PetugasKelurahan")
  zona           Zona[]
  rute           Rute[]
  ruteKelurahans Rute[]    @relation("RuteKelurahans")
  pelanggan      Pelanggan[]
}

model Wilayah {
  id           Int        @id @default(autoincrement())
  nama         String // nama wilayah, misal "RT 01", "Blok A"
  kode         String?    @unique // DEPRECATED: kode pelanggan kini dari Kelurahan.kode
  rt           String?
  rw           String?
  // DEPRECATED — sumber kebenaran kini di Kelurahan (kelurahanRef).
  // Kolom denormalisasi di bawah dipertahankan untuk kompatibilitas & data lama.
  kelurahan    String?
  kecamatan    String?
  kota         String?
  kelurahanId  Int? // canonical: satu kelurahan membawahi banyak RT/wilayah
  kelurahanRef Kelurahan? @relation("WilayahKelurahan", fields: [kelurahanId], references: [id])
  zonaId       Int? // zona area pengambilan sampah di dalam kelurahan (custom)
  zona         Zona?      @relation(fields: [zonaId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  pelanggan         Pelanggan[]
  petugas           Petugas[]
  rute              Rute[]
  pengumumanWilayah Pengumuman[] @relation("UntukWilayah")

  @@index([kelurahanId])
  @@index([zonaId])
}

model Zona {
  id          Int       @id @default(autoincrement())
  nama        String // nama zona custom, misal "Zona A - RT 01-05", "Zona Kalibaru Utara"
  keterangan  String?
  warna       String? // hex utk marker peta (#ff0000)
  kelurahanId Int
  kelurahan   Kelurahan @relation(fields: [kelurahanId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  wilayah Wilayah[]
  petugas ZonaPetugas[]
  rute    Rute[]
  ruteZonas Rute[] @relation("RuteZonas")
  pengangkutan Pengangkutan[]

  @@index([kelurahanId])
  @@index([deletedAt])
}

model ZonaPetugas {
  id        Int      @id @default(autoincrement())
  zonaId    Int
  petugasId Int
  createdAt DateTime @default(now())
  zona      Zona     @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  petugas   Petugas  @relation(fields: [petugasId], references: [id], onDelete: Cascade)

  @@unique([zonaId, petugasId])
  @@index([petugasId])
}

model KategoriTarif {
  id        Int      @id @default(autoincrement())
  kategori  String   @unique // level_1 | level_2 | level_3 | level_4 | level_5 | level_6 | level_7 | level_8 | level_9 | level_10
  label     String // label display
  tarif     Float // tarif default per bulan
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Paket {
  id        Int      @id @default(autoincrement())
  kode      String?  @unique // kode identitas paket, misal "paket_mbg"
  nama      String // misal "Paket A", "Paket B"
  harga     Float? // nominal tagihan default per bulan (null = tarif variabel)
  deskripsi String? // misal "2x seminggu", "setiap hari"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pelanggan Pelanggan[]
}

model Pelanggan {
  id               Int       @id @default(autoincrement())
  nama             String
  noTelepon        String    @unique
  kategori         String    @default("level_1") // level_1 | level_2 | level_3 | level_4 | level_5 | level_6 | level_7 | level_8 | level_9 | level_10
  alamat           String
  rtRw             String? // RT/RW
  kodePelanggan    String    @unique // kode unik untuk barcode
  fotoRumah        String? // URL/path foto
  patokanLokasi    String? // landmark/patokan
  latitude         Float? // koordinat untuk rute
  longitude        Float? // koordinat untuk rute
  koordinatSumber  String? // exif_foto | gps_perangkat | manual
  koordinatAkurasi Float? // akurasi koordinat (meter)
  penanggungjawab  String? // nama penanggung jawab
  referal          String? // siapa yang merefer
  customTarif      Float? // tarif kustom (override paket)
  status           String    @default("aktif") // aktif | calon | nonaktif | libur
  catatan          String?
  wilayahId        Int? // legacy: nullable — calon/daftar mandiri belum tentu punya RT
  kelurahanId      Int? // canonical: satu kelurahan membawahi banyak pelanggan (scope petugas & kode)
  paketId          Int?
  wilayah          Wilayah?  @relation(fields: [wilayahId], references: [id])
  kelurahan        Kelurahan? @relation(fields: [kelurahanId], references: [id])
  paket            Paket?    @relation(fields: [paketId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // soft delete

  jadwal         Jadwal[]
  tagihan        Tagihan[]
  pembayaran     Pembayaran[]
  pengangkutan   Pengangkutan[]
  komplain       Komplain[]
  liburSementara LiburSementara[]
  notifikasi     Notifikasi[]
  pesananPickup  PesananPickup[]

  @@index([deletedAt])
  @@index([status])
  @@index([kelurahanId])
  @@index([wilayahId])
}

model Petugas {
  id          Int        @id @default(autoincrement())
  nama        String
  noTelepon   String
  foto        String?
  email       String?
  jabatan     String? // angkut | tagih | survei (comma multi: "angkut,tagih")
  aktif       Boolean    @default(true)
  wilayahId   Int?
  wilayah     Wilayah?   @relation(fields: [wilayahId], references: [id])
  kelurahanId Int? // scope approval per kelurahan (fallback: kelurahan dari wilayahId)
  kelurahan   Kelurahan? @relation("PetugasKelurahan", fields: [kelurahanId], references: [id])
  userId      Int?       @unique // link ke akun login User
  user        User?      @relation(fields: [userId], references: [id])
  trackingToken String? @unique // token untuk background GPS tracking (native)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime? // soft delete

  rute         Rute[]
  pengangkutan Pengangkutan[]
  lokasi       LokasiPetugas[]
  kendaraan    Kendaraan[] // kendaraan yang dikemudikan
  absensi      Absensi[]
  klaim        KlaimPetugas[]
  chat         ChatPesan[]
  zona         ZonaPetugas[] // zona angkut yang ditugaskan (angkut)
  pesananPickup PesananPickup[]

  @@index([wilayahId])
  @@index([kelurahanId])
  @@index([aktif])
}

model LokasiPetugas {
  id        Int      @id @default(autoincrement())
  petugasId Int
  petugas   Petugas  @relation(fields: [petugasId], references: [id])
  latitude  Float
  longitude Float
  akurasi   Float? // akurasi GPS (meter)
  sumber    String? // gps_perangkat | manual
  createdAt DateTime @default(now())

  @@index([petugasId, createdAt])
}

model Kendaraan {
  id        Int       @id @default(autoincrement())
  nama      String // "Dump Truck 01", "Pickup 02"
  platNomor String? // plat kendaraan
  jenis     String    @default("dump_truck") // dump_truck | pickup | gerobak
  kapasitas Float? // kapasitas muat (kg)
  aktif     Boolean   @default(true)
  petugasId Int? // pengemudi utama
  petugas   Petugas?  @relation(fields: [petugasId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  pengangkutan Pengangkutan[]
  lokasi       LokasiKendaraan[]
  rute         Rute[]
  pesananPickup PesananPickup[]
}

model LokasiKendaraan {
  id          Int       @id @default(autoincrement())
  kendaraanId Int
  kendaraan   Kendaraan @relation(fields: [kendaraanId], references: [id])
  latitude    Float
  longitude   Float
  akurasi     Float? // akurasi GPS (meter)
  sumber      String? // gps_perangkat | manual
  createdAt   DateTime  @default(now())

  @@index([kendaraanId, createdAt])
}

model TitikTransit {
  id        Int      @id @default(autoincrement())
  nama      String // "Lapak Beji Utara" — tempat dump truck standby
  alamat    String?
  latitude  Float
  longitude Float
  aktif     Boolean  @default(true)
  catatan   String? // jam operasional, kontak, dll
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rute {
  id        Int      @id @default(autoincrement())
  nama      String // nama rute, misal "Rute A - RT 01"
  hari      String // Senin, Rabu, Jumat (comma-separated)
  jam       String? // jam estimasi
  aktif       Boolean    @default(true)
  wilayahId   Int?
  wilayah     Wilayah?  @relation(fields: [wilayahId], references: [id])
  kelurahanId Int?
  kelurahan   Kelurahan? @relation(fields: [kelurahanId], references: [id])
  kelurahans  Kelurahan[] @relation("RuteKelurahans")
  zonaId      Int?
  zona        Zona?     @relation(fields: [zonaId], references: [id])
  zonas       Zona[]    @relation("RuteZonas")
  kendaraanId Int? // armada mobil penjemput rute ini
  kendaraan   Kendaraan? @relation(fields: [kendaraanId], references: [id])
  petugasId   Int?
  petugas     Petugas? @relation(fields: [petugasId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jadwal Jadwal[]

  @@index([kendaraanId])
  @@index([petugasId])
}

model Jadwal {
  id          Int       @id @default(autoincrement())
  hari        String // Senin, Selasa, Rabu, Kamis, Jumat, Sabtu, Minggu
  jam         String? // jam estimasi
  aktif       Boolean   @default(true)
  pelangganId Int
  pelanggan   Pelanggan @relation(fields: [pelangganId], references: [id])
  ruteId      Int
  rute        Rute      @relation(fields: [ruteId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pengangkutan Pengangkutan[]

  @@unique([pelangganId, ruteId, hari])
  @@index([pelangganId])
  @@index([ruteId])
}

model Tagihan {
  id           Int       @id @default(autoincrement())
  noInvoice    String?   @unique // format: INV/{kodePelanggan}/{YYYYMM}
  bulan        Int // 1-12
  tahun        Int
  jumlah       Float // nominal tagihan
  denda        Float? // denda keterlambatan
  status       String    @default("belum_bayar") // belum_bayar | lunas | tunggakan | dibatalkan
  jatuhTempo   DateTime
  tanggalLunas DateTime?
  keterangan   String?
  pelangganId  Int
  pelanggan    Pelanggan @relation(fields: [pelangganId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // soft delete

  pembayaran Pembayaran[]

  @@unique([pelangganId, bulan, tahun])
  @@index([bulan, tahun, status])
  @@index([status])
  @@index([deletedAt])
  @@index([pelangganId, deletedAt])
}

model Pembayaran {
  id           Int       @id @default(autoincrement())
  tanggal      DateTime  @default(now())
  jumlah       Float
  metode       String // transfer | ewallet | qris | virtual_account | tunai | duitku
  buktiBayar   String? // URL foto bukti
  status       String    @default("terverifikasi") // terverifikasi | pending | ditolak
  catatan      String?
  tagihanId    Int
  tagihan      Tagihan   @relation(fields: [tagihanId], references: [id])
  pelangganId  Int
  pelanggan    Pelanggan @relation(fields: [pelangganId], references: [id])
  verifiedById Int? // admin yang verifikasi (jika bayar tunai)
  verifiedBy   User?     @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  duitkuTransaction DuitkuTransaction?

  @@index([tagihanId])
  @@index([pelangganId])
  @@index([status, createdAt])
}

model Pengangkutan {
  id          Int        @id @default(autoincrement())
  tanggal     DateTime   @default(now())
  status      String     @default("terjadwal") // terjadwal | diambil | tidak_diangkut | kosong
  volume      Float? // volume sampah (m³)
  berat       Float? // berat sampah (kg)
  jenisSampah String? // organik | anorganik | b3 | campuran
  catatan     String? // kendala: rumah kosong, sampah tidak ada, akses tertutup
  fotoBukti   String? // foto setelah diambil
  latitude    Float? // koordinat saat pickup
  longitude   Float? // koordinat saat pickup
  pelangganId Int
  pelanggan   Pelanggan  @relation(fields: [pelangganId], references: [id])
  petugasId   Int?
  petugas     Petugas?   @relation(fields: [petugasId], references: [id])
  kendaraanId Int? // mobil pickup/angkut yang mengambil
  kendaraan   Kendaraan? @relation(fields: [kendaraanId], references: [id])
  jadwalId    Int?
  jadwal      Jadwal?    @relation(fields: [jadwalId], references: [id], onDelete: SetNull)
  zonaId      Int? // zona angkut (snapshot dari rute/wilayah saat pickup)
  zona        Zona?      @relation(fields: [zonaId], references: [id])
  tpaId       Int?
  tpa         Tpa?       @relation(fields: [tpaId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime? // soft delete

  @@index([tanggal, status])
  @@index([pelangganId])
  @@index([petugasId])
  @@index([zonaId])
  @@index([deletedAt])
}

model Komplain {
  id           Int       @id @default(autoincrement())
  jenis        String    @default("tidak_diangkut") // tidak_diangkut | sampah_menumpuk | lainnya
  deskripsi    String
  foto         String?
  status       String    @default("baru") // baru | diproses | selesai
  tanggapan    String?
  pelangganId  Int
  pelanggan    Pelanggan @relation(fields: [pelangganId], references: [id])
  resolvedById Int?
  resolvedBy   User?     @relation("ResolvedBy", fields: [resolvedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([pelangganId])
}

model LiburSementara {
  id             Int       @id @default(autoincrement())
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  alasan         String // mudik, renovasi, dll
  pelangganId    Int
  pelanggan      Pelanggan @relation(fields: [pelangganId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Pengumuman {
  id             Int      @id @default(autoincrement())
  judul          String
  isi            String
  penting        Boolean  @default(false)
  untukWilayahId Int? // null = semua wilayah
  untukWilayah   Wilayah? @relation("UntukWilayah", fields: [untukWilayahId], references: [id])
  createdById    Int
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Pengeluaran {
  id          Int      @id @default(autoincrement())
  tanggal     DateTime @default(now())
  kategori    String // bbm | gaji_petugas | perawatan | operasional | lainnya
  jumlah      Float
  keterangan  String
  bukti       String?
  dicatatById Int
  dicatatBy   User     @relation(fields: [dicatatById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tpa {
  id        Int      @id @default(autoincrement())
  nama      String
  alamat    String?
  kota      String?
  jarak     Float? // jarak dari kota (km)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pengangkutan Pengangkutan[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  aksi      String // create | update | delete
  entitas   String // nama model: Pelanggan, Tagihan, dll
  entitasId Int // id record
  dataLama  String? // JSON data sebelum perubahan
  dataBaru  String? // JSON data setelah perubahan
  userId    Int?
  user      User?    @relation("AuditUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Notifikasi {
  id          Int        @id @default(autoincrement())
  tipe        String // tagihan_jatuh_tempo | jadwal_pengangkutan | komplain_diproses | pengumuman
  judul       String
  pesan       String
  penerima    String // no telepon
  status      String     @default("pending") // pending | terkirim | gagal
  pelangganId Int?
  pelanggan   Pelanggan? @relation(fields: [pelangganId], references: [id])
  dikirimPada DateTime?
  error       String?
  createdById Int?
  createdBy   User?      @relation("NotifCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
}

model Rekonsiliasi {
  id               Int      @id @default(autoincrement())
  tanggal          DateTime @default(now())
  totalPemasukan   Float    @default(0)
  totalPengeluaran Float    @default(0)
  totalTunaiSistem Float    @default(0)
  totalTunaiFisik  Float?
  selisih          Float?
  catatan          String?
  userId           Int?
  user             User?    @relation(fields: [userId], references: [id])
  createdAt        DateTime @default(now())
}

model Pengaturan {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model DuitkuTransaction {
  id            Int        @id @default(autoincrement())
  orderId       String     @unique // order_id Duitku (DW-{pembayaranId}-{ts})
  pembayaranId  Int        @unique
  pembayaran    Pembayaran @relation(fields: [pembayaranId], references: [id])
  paymentUrl    String? // URL pembayaran Duitku (redirect pelanggan ke sini)
  reference     String? // reference dari Duitku
  paymentMethod String? // VC | QR | SP | OVO | DANA | M1 | dll
  statusCode    String? // 00 = sukses | 01 = proses | 02 = gagal/expired
  statusMessage String?
  amount        Float?
  rawResponse   String? // response terakhir (JSON, dipotong 4KB)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Absensi {
  id            Int       @id @default(autoincrement())
  petugasId     Int
  petugas       Petugas   @relation(fields: [petugasId], references: [id])
  waktuMasuk    DateTime  @default(now())
  lokasiMasuk   String? // JSON (lat, lng, accuracy) atau string text
  waktuSelesai  DateTime?
  lokasiSelesai String?
  catatan       String?
  status        String    @default("hadir") // hadir | izin | sakit | alpa
}

model KlaimPetugas {
  id             Int       @id @default(autoincrement())
  petugasId      Int
  petugas        Petugas   @relation(fields: [petugasId], references: [id])
  tanggal        DateTime  @default(now())
  kategori       String // bbm | perawatan | gaji_petugas | lainnya
  nominal        Float
  keterangan     String
  fotoBukti      String?
  status         String    @default("menunggu") // menunggu | disetujui | ditolak
  catatanAdmin   String?
  diperiksaById  Int?
  diperiksaBy    User?     @relation("KlaimDiperiksa", fields: [diperiksaById], references: [id])
  waktuDiperiksa DateTime?
}

model ChatPesan {
  id          Int      @id @default(autoincrement())
  petugasId   Int
  petugas     Petugas  @relation(fields: [petugasId], references: [id], onDelete: Cascade)
  userId      Int? // pengirim dari sisi admin/kasir/superadmin (User); null jika dari petugas
  user        User?    @relation("ChatUser", fields: [userId], references: [id], onDelete: SetNull)
  dariPetugas Boolean // true = kiriman petugas, false = kiriman admin
  isi         String
  dibaca      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([petugasId, createdAt])
  @@index([userId])
}

model Artikel {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  judul       String
  isi         String
  kategori    String   @default("edukasi") // edukasi | informasi | berita
  gambar      String?  // url gambar
  diterbitkan Boolean  @default(false)
  penulisId   Int?
  penulis     User?    @relation(fields: [penulisId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([diterbitkan, createdAt])
}

// ==========================================
// MARKETPLACE PRODUK RESMI UPS HERU
// ==========================================

model Produk {
  id          Int      @id @default(autoincrement())
  nama        String
  slug        String   @unique
  kategori    String   // pupuk_kompos | pupuk_cair | maggot | alat_kebersihan | tempat_sampah | kantong_sampah | lainnya
  harga       Float
  stok        Int      @default(0)
  satuan      String   @default("sak") // sak | botol | kg | pcs | paket
  beratGram   Int      @default(1000)
  deskripsi   String
  foto        String?
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  MarketplaceOrderItem[]

  @@index([kategori, aktif])
}

model MarketplaceOrder {
  id           Int                    @id @default(autoincrement())
  noPesanan    String                 @unique // format: ORD/YYYYMMDD/XXXX
  namaPembeli  String
  noTelepon    String
  email        String?
  alamat       String
  kelurahan    String?
  kecamatan    String?
  catatan      String?
  totalHarga   Float
  ongkir       Float                  @default(0)
  status       String                 @default("menunggu_pembayaran") // menunggu_pembayaran | diproses | dikirim | selesai | dibatalkan
  metodeBayar  String                 // qris | transfer | cod | duitku
  buktiBayar   String?
  tanggalBayar DateTime?
  kurirNama    String?
  noResi       String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  items        MarketplaceOrderItem[]

  @@index([status, createdAt])
  @@index([noTelepon])
}

model MarketplaceOrderItem {
  id          Int              @id @default(autoincrement())
  orderId     Int
  order       MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  produkId    Int
  produk      Produk           @relation(fields: [produkId], references: [id])
  jumlah      Int
  hargaSatuan Float
  subtotal    Float

  @@index([orderId])
  @@index([produkId])
}

// ==========================================
// LAYANAN PICKUP SAMPAH SEKALI ANGKUT
// ==========================================

model KategoriPickup {
  id            Int             @id @default(autoincrement())
  kode          String          @unique // puing | ranting | bulky | event | ewaste
  nama          String          // "Puing Bangunan & Renovasi"
  deskripsi     String?
  satuanMuatan  String          // karung | rit_pickup | rit_truk | unit
  tarifDasar    Float           // Biaya dasar (misal Rp 100.000)
  tarifPerUnit  Float?          // Biaya per unit/karung/barang (misal Rp 15.000)
  armadaStandar String?         // pickup | dump_truck | tossa
  icon          String?         // Lucide icon name
  aktif         Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  pesananPickup PesananPickup[]
}

model PesananPickup {
  id               Int            @id @default(autoincrement())
  noOrder          String         @unique // format: PKP/YYYYMMDD/XXXX
  namaPemesan      String
  noTelepon        String
  alamat           String
  patokan          String?
  kelurahan        String?
  kecamatan        String?
  latitude         Float?
  longitude        Float?
  
  kategoriPickupId Int
  kategoriPickup   KategoriPickup @relation(fields: [kategoriPickupId], references: [id])
  
  estimasiMuatan   String         // e.g. "10 karung", "1 kasur + 1 sofa"
  fotoSampah       String?
  tanggalJemput    DateTime
  waktuJemput      String?        // pagi | siang | fleksibel
  
  estimasiBiaya    Float
  biayaFinal       Float?
  
  metodeBayar      String         @default("cod") // cod | qris | transfer | duitku
  statusBayar      String         @default("belum_bayar") // belum_bayar | lunas
  buktiBayar       String?
  
  status           String         @default("menunggu_konfirmasi") // menunggu_konfirmasi | dikonfirmasi | ditugaskan | otw | dijemput | selesai | dibatalkan
  catatanPetugas   String?
  fotoSelesai      String?
  
  petugasId        Int?
  petugas          Petugas?       @relation(fields: [petugasId], references: [id])
  kendaraanId      Int?
  kendaraan        Kendaraan?     @relation(fields: [kendaraanId], references: [id])
  pelangganId      Int?
  pelanggan        Pelanggan?     @relation(fields: [pelangganId], references: [id])
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  selesaiAt        DateTime?

  @@index([status, tanggalJemput])
  @@index([noTelepon])
  @@index([petugasId])
  @@index([kategoriPickupId])
}

// ==========================================
// MARKETPLACE MULTI-SELLER (EKONOMI SIRKULAR)
// ==========================================

model SellerProfile {
  id           Int           @id @default(autoincrement())
  uuid         String        @unique @default(uuid())
  userId       Int           @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  namaToko     String
  slug         String        @unique
  deskripsi    String?
  logo         String?
  banner       String?
  alamat       String
  kelurahan    String?
  kecamatan    String?
  kota         String        @default("Kota Depok")
  noTelepon    String
  status       String        @default("pending") // pending | aktif | suspended | ditolak
  bankNama     String?
  bankRekening String?
  bankAtasNama String?
  saldo        Float         @default(0)
  rating       Float         @default(5.0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  products     Product[]
  sellerOrders SellerOrder[]

  @@index([status, createdAt])
  @@index([slug])
}

model Category {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(uuid())
  nama      String
  slug      String    @unique
  deskripsi String?
  icon      String?
  aktif     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@index([slug, aktif])
}

model Product {
  id          Int            @id @default(autoincrement())
  uuid        String         @unique @default(uuid())
  sellerId    Int
  seller      SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id])
  nama        String
  slug        String         @unique
  deskripsi   String
  harga       Float
  stok        Int            @default(0)
  satuan      String         @default("pcs")
  beratGram   Int            @default(1000)
  status      String         @default("aktif") // draft | aktif | nonaktif | arsip
  rating      Float          @default(5.0)
  terjual     Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([slug])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  urutan    Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, urutan])
}

model Cart {
  id        Int        @id @default(autoincrement())
  uuid      String     @unique @default(uuid())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  jumlah    Int      @default(1)
  catatan   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Order {
  id               Int           @id @default(autoincrement())
  uuid             String        @unique @default(uuid())
  noOrder          String        @unique
  userId           Int?
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  namaPembeli      String
  noTelepon        String
  email            String?
  alamatPengiriman String
  kelurahan        String?
  kecamatan        String?
  kodePos          String?
  totalProduk      Float
  totalOngkir      Float         @default(0)
  totalBayar       Float
  status           String        @default("pending_payment") // pending_payment | paid | processing | shipped | completed | cancelled | expired
  catatan          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sellerOrders     SellerOrder[]
  payments         Payment[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([noOrder])
  @@index([noTelepon])
}

model SellerOrder {
  id            Int           @id @default(autoincrement())
  uuid          String        @unique @default(uuid())
  noSubOrder    String        @unique
  orderId       Int
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId      Int
  seller        SellerProfile @relation(fields: [sellerId], references: [id])
  totalHarga    Float
  ongkir        Float         @default(0)
  status        String        @default("pending_payment") // pending_payment | paid | processing | shipped | completed | cancelled
  catatanSeller String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]
  shipment      Shipment?

  @@index([orderId])
  @@index([sellerId, status])
  @@index([noSubOrder])
}

model OrderItem {
  id            Int         @id @default(autoincrement())
  uuid          String      @unique @default(uuid())
  sellerOrderId Int
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  namaProduk    String
  hargaSatuan   Float
  beratGram     Int         @default(1000)
  satuan        String      @default("pcs")
  foto          String?

  jumlah        Int         @default(1)
  subtotal      Float
  createdAt     DateTime    @default(now())

  @@index([sellerOrderId])
  @@index([productId])
}

model Payment {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid())
  orderId      Int
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  noTransaksi  String    @unique
  metodeBayar  String
  nominal      Float
  status       String    @default("pending") // pending | success | failed | expired | refunded
  gatewayRef   String?
  vaNumber     String?
  qrString     String?
  waktuExpired DateTime?
  waktuBayar   DateTime?
  rawResponse  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orderId])
  @@index([noTransaksi])
  @@index([status])
}

model Shipment {
  id            Int         @id @default(autoincrement())
  uuid          String      @unique @default(uuid())
  sellerOrderId Int         @unique
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  kurirNama     String      @default("Kurir Toko")
  noResi        String?
  ongkir        Float       @default(0)
  estimasiTiba  String?
  status        String      @default("menunggu_dikirim") // menunggu_dikirim | dalam_pengiriman | terkirim | gagal
  dikirimAt     DateTime?
  diterimaAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([noResi])
}

// ============================================================================
// MULTI-TENANT SAAS ARCHITECTURE MODELS (O2W HERO CORE & MITRA ECOSYSTEM)
// ============================================================================

model Tenant {
  id                 String             @id @default(uuid())
  slug               String             @unique // e.g. "upsheru", "bank-sampah-berkah"
  namaMitra          String             // e.g. "UPS HERU Kota Depok"
  penanggungJawab    String?
  noTelepon          String?
  email              String?
  alamat             String?
  kota               String?            @default("Depok")
  provinsi           String?            @default("Jawa Barat")
  tipePengelola      String             @default("tps3r") // tps3r | bank_sampah | pengepul | swasta | dlh
  status             String             @default("aktif") // aktif | nonaktif | masa_percobaan | suspend
  paketLangganan     String             @default("percontohan") // percontohan | basic | pro | enterprise
  dbConnectionString String?            // Kredensial DB terpisah jika Database-per-Tenant
  dbSchemaName       String?            // Nama skema terpisah jika PostgreSQL Multi-Schema
  customDomain       String?            @unique // e.g. "upsheru.com"
  subdomain          String?            @unique // e.g. "upsheru.o2whero.com"
  logoUrl            String?
  warnaTema          String?            @default("#059669")
  fiturAktif         String?            // Konfigurasi fitur aktif (JSON string)
  catatan            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  domains            TenantDomain[]
  mitraRegistrasi    MitraRegistration?
  users              User[]

  // Relasi Konfigurasi WhatsApp (2 Nomor Mitra) & Kuota
  waConfig           TenantWhatsAppConfig?
  quotaUsage         TenantQuotaUsage?

  // Relasi Konfigurasi Payment Gateway & Komisi
  paymentConfig      TenantPaymentConfig?
  ledgers            TenantLedger[]
  payouts            TenantPayout[]

  @@index([slug])
  @@index([customDomain])
  @@index([subdomain])
  @@index([status])
}

model TenantDomain {
  id         Int      @id @default(autoincrement())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain     String   @unique // e.g. "upsheru.com", "www.upsheru.com"
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(true)
  sslStatus  String   @default("active") // active | pending | failed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([domain])
  @@index([tenantId])
}

model MitraRegistration {
  id            Int      @id @default(autoincrement())
  namaLengkap   String
  namaInstansi  String   // Nama Bank Sampah / TPS / Perusahaan
  jenisUsaha    String   // bank_sampah | tps3r | pengepul | swasta
  noWhatsapp    String
  email         String
  kota          String
  estimasiWarga Int      @default(0) // Jumlah nasabah/KK terlayani
  kebutuhanDb   String   @default("dedicated") // dedicated (db per tenant) | shared
  status        String   @default("menunggu_review") // menunggu_review | disetujui | ditolak | provisioned
  catatanAdmin  String?
  tenantId      String?  @unique
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([noWhatsapp])
}

// ============================================================================
// KONFIGURASI WHATSAPP DUA NOMOR & KUOTA BULANAN MULTI-TENANT
// ============================================================================

model TenantWhatsAppConfig {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  gatewayMode        String   @default("dedicated_mitra") // dedicated_mitra | shared_pool
  provider           String   @default("fonnte") // fonnte | wablas | meta_waba
  
  // Nomor WhatsApp 1: Nomor Operasional Utama (Bot, Tagihan & Kuitansi Lunas)
  waNumber1          String?  // misal "081400782617"
  waApiKey1          String?  // Token API Device 1
  waLabel1           String?  @default("Nomor Utama (Bot & Tagihan)")
  
  // Nomor WhatsApp 2: Nomor CS & Layanan Pengaduan Warga
  waNumber2          String?  // misal "081234567890"
  waApiKey2          String?  // Token API Device 2
  waLabel2           String?  @default("Nomor CS & Pengaduan")
  
  // Nomor Internal Pengelola untuk Notifikasi
  adminPhone         String?  // Nomor WA Admin Lapangan
  ownerPhone         String?  // Nomor WA Owner / Direksi Mitra
  waGroupTagihan     String?  // JID Grup WA Laporan Pembayaran (@g.us)
  waGroupPengaduan   String?  // JID Grup WA Laporan Pengaduan (@g.us)
  
  blastDelayMs       Int      @default(1500)
  autoSendEnabled    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([waNumber1])
  @@index([waNumber2])
}

model TenantQuotaUsage {
  id                   String    @id @default(uuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  kuotaBulanan         Int       @default(1000) // Kuota dasar per paket (Starter 1000, Pro 5000, Enterprise 20000)
  kuotaTopup           Int       @default(0)    // Kuota tambahan berbayar (rollover permanen)
  pesanTerkirim        Int       @default(0)    // Counter pesan sukses terkirim siklus ini
  pesanGagal           Int       @default(0)    // Counter pesan gagal
  overdraftUsed        Int       @default(0)    // Pemakaian kuota darurat P0
  biayaPerPesanOverage Float     @default(150)  // Biaya per pesan ekstra (Rp 150)
  
  periodeMulai         DateTime  @default(now())
  periodeBerakhir      DateTime
  
  alert80SentAt        DateTime?
  alert100SentAt       DateTime?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId])
  @@index([periodeBerakhir])
}

// ============================================================================
// KONFIGURASI PAYMENT GATEWAY & KOMISI PLATFORM MULTI-TENANT
// ============================================================================

model TenantPaymentConfig {
  id                 Int      @id @default(autoincrement())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Mode Gateway: "centralized_pool" (O2W HERO Pool) atau "dedicated" (Kredensial Mandiri Mitra)
  gatewayMode        String   @default("centralized_pool")
  merchantCode       String?  // Terisi jika mode dedicated
  apiKey             String?  // Terisi jika mode dedicated

  // Kebijakan Pembebanan Biaya: "customer" (ditambah ke warga) | "tenant" (disubsidi) | "hybrid"
  feeBearerPolicy    String   @default("hybrid")
  
  // Biaya Admin yang Ditagihkan ke Warga
  adminFeeQris       Float    @default(1500) // Default Rp 1.500
  adminFeeVa         Float    @default(3500) // Default Rp 3.500
  adminFeeEwallet    Float    @default(2000) // Default Rp 2.000

  // Komisi / Micro-Fee Platform O2W HERO
  platformFeeNominal Float    @default(1000) // Komisi O2W HERO per transaksi lunas (Rp 1.000)
  platformFeeRate    Float    @default(0)

  // Rekening Pencairan Kas Mitra
  bankName           String?  // BCA, Mandiri, BRI, BNI
  bankAccountNumber  String?
  bankAccountHolder  String?
  payoutSchedule     String   @default("weekly") // daily | weekly | manual

  aktif              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
}

// ============================================================================
// ESCROW MUTASI SALDO & SETTLEMENT MITRA (VIRTUAL LEDGER)
// ============================================================================

model TenantLedger {
  id                 Int      @id @default(autoincrement())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pembayaranId       Int?
  
  tipe               String   // CREDIT_PAYMENT | DEBIT_PAYOUT | ADJUSTMENT
  nominalGross       Float    // Total uang masuk dari warga
  feeGateway         Float    // Potongan gateway Duitku
  feePlatform        Float    // Komisi O2W HERO
  nominalNet         Float    // Kas bersih hak mitra
  saldoSetelah       Float    // Saldo berjalan kas mitra di pool O2W
  keterangan         String?
  createdAt          DateTime @default(now())

  @@index([tenantId, createdAt])
}

model TenantPayout {
  id                 Int      @id @default(autoincrement())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nomorBatch         String   @unique // PO/YYYYMMDD/XXXX
  totalNominal       Float    // Total dana ditransfer ke mitra
  biayaTransfer      Float    @default(0)
  nominalDiterima    Float
  bankTujuan         String
  rekeningTujuan     String
  namaPenerima       String
  status             String   @default("proses") // proses | berhasil | ditolak
  buktiTransfer      String?
  catatan            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}
